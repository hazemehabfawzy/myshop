# ==========================================
#  TechVault - Professional GitIgnore Profile
# ==========================================

# ------------------------------------------
# 1. Dependencies (reinstalled via npm install)
# ------------------------------------------
node_modules/
frontend/node_modules/
backend/node_modules/
techvault-frontend/node_modules/

# ------------------------------------------
# 2. Environment Variables (sensitive data)
# ------------------------------------------
.env
.env.local
.env.development
.env.production
.env.test

# ------------------------------------------
# 3. Build & Compiler Outputs (auto-generated)
# ------------------------------------------
frontend/build/
frontend/dist/
backend/dist/
techvault-frontend/dist/
[Bb]in/
[Oo]bj/

# ------------------------------------------
# 4. Logs
# ------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ------------------------------------------
# 5. OS & System Junk Files
# ------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ------------------------------------------
# 6. IDEs, Editors & Project Settings
# ------------------------------------------
.vscode/
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.ntvs*
*.njsproj
*.sln

# ------------------------------------------
# 7. Caches
# ------------------------------------------
.cache/
.parcel-cache/
.eslintcache

# ------------------------------------------
# 8. User-Uploaded & Storage Files
# ------------------------------------------
backend/uploads/
*.db
*.db-shm
*.db-wal
techvault.db

# ------------------------------------------
# 9. Test Coverage & Testing
# ------------------------------------------
coverage/
.nyc_output/
